# Copie para .env e preencha. O .env NÃO vai para o git.
#
# Chaves da Groq (console.groq.com) — provedor de inferência que roda o
# llama-3.1-8b-instant usado em imoveis_jp.processing.extract_llm_features.
# NÃO confundir com o Grok da xAI: são produtos diferentes e a chave da xAI
# (prefixo xai-) não funciona aqui.
#
# Separe múltiplas chaves por vírgula. O módulo faz rodízio entre elas para
# distribuir o limite de requisições por minuto.
GROQ_API_KEYS=gsk_chave1,gsk_chave2

# Alternativa aceita para uma chave só:
# GROQ_API_KEY=gsk_chave

# Alternativa aceita para chaves numeradas:
# GROQ_API_KEY_1=gsk_chave1
# GROQ_API_KEY_2=gsk_chave2
